# Story Mapping SvelteKit site.
#
# Traefik terminates TLS and proxies here over windshift.network, so Caddy
# only ever speaks plain HTTP on :8074.
:8074 {
	root * /srv

	encode gzip zstd

	# The Journey Mapping app is retired; it was folded into Story Mapping.
	# DNS for journeymapping.app now points at this host, and Traefik forwards
	# the original Host header, so send every request to the Story Mapping
	# home page with a permanent (301) redirect. Match the apex and www in one
	# rule; the path is intentionally dropped because the retired app's routes
	# do not map onto Story Mapping's.
	@journeymapping host journeymapping.app www.journeymapping.app
	redir @journeymapping https://storymapping.app/ 301

	# adapter-static emits flat .html files. Normalize trailing-slash requests
	# before try_files sees a matching directory (for example /docs/), otherwise
	# Caddy attempts to serve the directory and returns 404.
	#
	# Backslashes are excluded: browsers treat "\" like "/" when resolving a
	# redirect, so echoing one back would turn this into an open redirect:
	# "/%5Cevil.com/" would become "Location: /\evil.com" and resolve to
	# https://evil.com. No route uses a backslash, so those requests fall
	# through to a real 404 instead of being redirected.
	@trailingSlash {
		path_regexp trailingSlash ^(.+)/$
		not path_regexp backslash `(?i)(\\|%5c)`
	}
	redir @trailingSlash {re.trailingSlash.1} 308

	# The established production URLs stay canonical. Redirect only the route
	# names introduced during the SvelteKit migration back to those URLs.
	redir /showcase/basic /free-app 301
	redir /docs/pro /docs/pro-app 301
	redir /docs/pro/features/board /docs/pro-app/board 301
	redir /docs/pro/features/export /docs/pro-app/export 301
	redir /docs/pro/features/map-types /docs/pro-app/map-types 301
	redir /docs/pro/overview /docs/pro-app/overview 301
	redir /docs/pro/admin-guide /docs/pro-app/pro-admin-guide 301
	redir /docs/pro/features/settings /docs/pro-app/pro-settings 301
	redir /docs/pro/setup /docs/pro-app/pro-setup 301
	redir /docs/pro/features/using-the-app /docs/pro-app/pro-story-mapping 301
	redir /docs/pro/features/hierarchy /docs/pro-app/top-level-elements 301
	redir /docs/pro/tutorials/custom-field-swimlanes /docs/tutorials/custom-field-swimlanes 301
	redir /docs/pro/tutorials/multi-project-releases /docs/tutorials/multi-project-releases 301
	redir /docs/support/story-maps-to-advanced /docs/support/freetopro 301
	redir /upgrade /free-app 301

	# URLs from the earlier Docusaurus site that Google still crawls (two were
	# reported as 404 in October 2026). Each goes to the page that now carries
	# the same content, matched by the archived page titles. Old URLs with no
	# current equivalent (/docs/roadmap, /docs/parent-link-instructions,
	# /freevspro, /blog/what-problem-does-story-mapping-solve) stay 404.
	redir /docs/overview /docs 301
	redir /docs/setup /docs/getting-started 301
	redir /docs/usage /docs/tutorials/working-with-the-map 301
	redir /docs/usage2 /docs/tutorials/planning-sprints-and-releases 301
	redir /docs/storyvsjourneymap /docs/best-practices/storyvsjourneymap 301
	redir /docs/release-notes /docs/whatsnew 301
	redir /whatsnew /docs/whatsnew 301
	redir /docs/eula /docs/support/eula 301
	redir /docs/privacy /docs/support/privacy 301
	redir /docs/troubleshooting /docs/support/troubleshooting 301
	redir /docs/freetopro /docs/support/freetopro 301
	redir /docs/pro-features /docs/pro/features 301
	redir /docs/export /docs/pro-app/export 301
	redir /docs/map-types /docs/pro-app/map-types 301
	redir /docs/pro-admin-guide /docs/pro-app/pro-admin-guide 301
	redir /docs/pro-settings /docs/pro-app/pro-settings 301
	redir /docs/pro-setup /docs/pro-app/pro-setup 301
	redir /docs/pro-story-mapping /docs/pro-app/pro-story-mapping 301
	redir /docs/top-level-elements /docs/pro-app/top-level-elements 301
	redir /blog/creating-a-portfolio-map-with-storymapping-for-jira-pro /articles/creating-a-portfolio-map-with-advanced-storymaps 301
	redir /blog/how-to-get-started-with-user-story-mapping /articles/get-started-with-user-story-mapping 301
	redir /blog/storymapping-for-jira-what-can-it-do /articles/story-maps-for-jira 301
	redir /blog/archive /blog 301
	redir /blog/tags* /blog 301

	# Everything under _app/immutable is content-hashed by SvelteKit.
	header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://data.windshift.dev; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://images.unsplash.com https://marketplace.atlassian.com; object-src 'none'; script-src 'self' 'unsafe-inline' https://data.windshift.dev; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
	}

	# adapter-static emits flat files — /docs/support is docs/support.html.
	# Resolve those before 404ing. Without
	# this every subpage would miss and fall through.
	try_files {path} {path}.html {path}/index.html
	file_server

	log
}
